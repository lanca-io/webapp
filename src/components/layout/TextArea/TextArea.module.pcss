.container {
	flex: 1;
	border-radius: 12px;
	overflow: hidden;
}

.textarea {
	border: 1px solid var(--color-gray-600);
	border-radius: 12px;
	width: 100%;
	height: 100%;
	padding: var(--space-s);
	background-color: var(--color-grey-650);
	color: var(--color-gray-500);
	font-family: inherit;
	font-size: 0.875rem;
	box-sizing: border-box;
	resize: none;
	transition: border 0.2s ease-in-out;

	&::placeholder {
		color: var(--color-gray-500);
	}

	&:hover {
		border-color: var(--color-gray-700);
	}

	&:focus {
		border-color: var(--color-gray-700);
	}

	&:active {
		border-color: var(--color-gray-700);
	}
}

.textarea:hover {
	border: 1px solid var(--color-grey-550);
}

.textarea:focus-visible {
	outline: unset;
	border: 1px solid var(--color-pacific-500);
}
