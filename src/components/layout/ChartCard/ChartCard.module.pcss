.header {
	width: 100%;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-xs);
}

.title {
	font-size: 1.125rem;
	color: var(--color-gray-600);
}

.smallTitle {
	font-size: 1.125rem;
	color: var(--color-gray-600);
}

.value {
	font-size: 2.25rem;
	color: var(--color-gray-700);
	margin-bottom: var(--space-xs);
}

.smallValue {
	font-size: 1.5rem;
	color: var(--color-gray-700);
	margin-bottom: var(--space-xs);
}
