.container {
	width: calc(100% - 8px);
	margin: 0 auto;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	border-radius: var(--space-s);
	padding: var(--space-xxs) var(--space-xs);
	cursor: pointer;
	transition: background-color 0.2s ease-in-out;

	&:hover {
		background-color: var(--color-gray-200);
	}

	&:active {
		background-color: var(--color-gray-300);
	}
}

.selected {
	background-color: var(--color-gray-100);
	box-shadow:
		0 0 0 2px #f9fbfb,
		0 0 0 4px var(--color-accent-500, #0ba5ec);
}

.tokenTitleContainer {
	padding: var(--space-xxs);
}

.tokenInfoContainer {
	flex-direction: row;
	align-items: center;
	gap: var(--space-xxs);
}

.tokenName {
	color: var(--color-gray-600);
}

.tokenPriceContainer {
	align-items: flex-end;

	h4 {
		color: var(--color-gray-600);
	}
}

.balanceSkeleton {
	width: 30px;
	height: 16px;
	border-radius: 12px;
}

.tokenAddressContainer {
	height: 16px;
	overflow: hidden;
}

.tokenAddress {
	flex-direction: row;
	align-items: center;
	gap: var(--space-xxs);

	p {
		font-weight: 500 !important;
	}
}

.linkButton:hover {
	transform: translateY(-1px);
}
