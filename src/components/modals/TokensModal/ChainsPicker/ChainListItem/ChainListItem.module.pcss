.container {
	border-radius: 16px;
	max-width: 96px;
	width: 100%;
	align-items: center;
	gap: var(--space-xxs);
	cursor: pointer;
	padding: var(--space-xs);
	transition: 0.2s ease-in-out;

	&:focus {
		box-shadow:
			0 0 0 2px #f9fbfb,
			0 0 0 4px var(--color-accent-500, #0ba5ec);
		background-color: var(--color-gray-100);
	}

	&:hover {
		background-color: var(--color-gray-200);
	}

	&:active {
		background-color: var(--color-gray-300);
	}
}

.name {
	font-weight: 500;
	font-size: 0.875rem;
	color: var(--color-gray-600);
}

.selectedName {
	color: var(--color-gray-700);
}

.chainButton {
	border-radius: 8px;
	transition: 0.2s ease-in-out;
}

.selected {
	box-shadow:
		0 0 0 2px #f9fbfb,
		0 0 0 4px var(--color-accent-500, #0ba5ec);
	background-color: var(--color-gray-50) !important;
}

.cropped {
	justify-content: center;
	width: unset;
	padding: var(--space-xs);
}

.chainIcon {
	width: 40px;
	height: 40px;

	img {
		border-radius: 12px;
		width: 100%;
		height: 100%;
	}
}
