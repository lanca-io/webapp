.header_burger {
	position: relative;

	& .header_burger_container {
		display: flex;
		flex-direction: column;
		position: fixed;
		top: var(--header-height);
		left: 0;
		width: 100vw;
		height: calc(100vh - var(--header-height));
		overflow-y: auto;
		padding: var(--space-m);
		background-color: var(--color-gray-25);
		gap: var(--space-s);
		z-index: 100;
	}

	& .header_burger_divider {
		width: 100%;
		height: 1px;
		background-color: var(--color-gray-100);
	}
}
