.header_dropdown {
	position: relative;

	& .header_dropdown_container {
		display: flex;
		flex-direction: column;
		position: absolute;
		right: 0;
		top: 100%;
		margin-top: var(--space-s);
		padding: var(--space-m);
		width: 320px;
		background-color: var(--color-gray-25);
		border-radius: 24px;
		box-shadow: 0 2px 12px 0 var(--color-gray-300);
		gap: var(--space-s);
		z-index: 10;
	}

	& .header_dropdown_divider {
		width: 100%;
		height: 1px;
		background-color: var(--color-gray-100);
	}
}
