.header {
	position: relative;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	height: 32px;
	margin-bottom: var(--space-m);

	h4 {
		color: var(--color-gray-700);
		font-size: 1.125rem;
	}
}

.close {
	position: absolute;
	left: 0;
}

.tokenAreasContainer {
	position: relative;
	gap: var(--space-m);
	margin-bottom: var(--space-m);
}

.separatorWrap {
	position: relative;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 32px;
}

.separator {
	width: 100%;
	height: 1px;
	background-color: var(--color-gray-200);
}

.arrowsIcon {
	margin: 0 var(--space-m);
}

.feeDetails {
	margin-top: var(--space-m);
}

.actionButton {
	height: 48px;
}
