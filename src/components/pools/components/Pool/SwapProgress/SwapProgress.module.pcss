.container {
	width: 100%;
	gap: var(--space-m);
	align-items: center;
}

.header {
	width: 100%;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding: 9px 0;
	position: relative;

	h3 {
		color: var(--color-gray-700);
	}
}

.backButton {
	position: absolute;
	left: 0;
}

.closeButton {
	position: absolute;
	right: 0;
}

.stateImg {
	width: 128px;
	height: 128px;
	justify-content: center;
	align-items: center;
	border-radius: var(--space-s);
}

.stateImgPending {
	background: var(--color-accent-50);
}

.stateImgSuccess {
	background: var(--color-success-50);
}

.stateImgFail {
	background: radial-gradient(50% 50% at 50% 50%, #fffcf5 0%, #fffaeb 50.5%, #fef0c7 100%);
}

.tokensInfoContainer {
	width: 100%;
	gap: var(--space-s);
	background-color: var(--color-gray-600);
	border-radius: 12px;

	.tokenInfoItem {
		flex-direction: row;
		gap: var(--space-xs);

		h4 {
			color: var(--color-text-secondary);
		}
	}
}

.progressContainer {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: var(--space-s);
}

.buttonsContainer {
	flex-direction: row;
	align-items: center;
	gap: var(--space-s);
}

.button {
	flex: 1;
}

.infoMessage {
	width: 100%;
	padding: var(--space-xs);
	gap: var(--space-xs);
	border-radius: var(--space-s);
	background-color: var(--color-accent-100);
	justify-content: center;
	align-items: center;
}

.wrapIcon {
	background-color: var(--color-accent-25);
	padding: var(--space-s);
	border-radius: var(--space-s);
	justify-content: center;
	align-items: center;
}

.messageTitle {
	color: var(--color-accent-700);
	font-size: 1.125rem;
}

.messageSubtitle {
	color: var(--color-accent-600);
	text-align: center;
	font-size: 1rem;
}

.warningTitle {
	color: #000000;
}

.warningSubtitle {
	color: var(--color-accent-700);
}

.timer {
	color: var(--color-gray-700) !important;
	font-weight: 500;
}

.actionButton {
	height: 48px;
}
