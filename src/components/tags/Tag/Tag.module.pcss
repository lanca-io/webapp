.container {
	flex-direction: row;
	flex-wrap: nowrap;
	white-space: nowrap;
}

.tag {
	align-items: center;
	border-radius: 8px;
	flex-direction: row;
	gap: var(--space-xxs);
	justify-content: center;
	padding: 2px var(--space-xs);
}

.xs {
	padding: var(--space-xxs) var(--space-xs);
}

.xxs {
	padding: 2px 2px;
}

.md {
	padding: var(--space-xs) var(--space-s);
}

.lg {
	padding: var(--space-s) var(--space-m);
}

.red {
	color: var(--color-red-500);
	background-color: var(--color-red-700);
	border: 1px solid var(--color-red-650);
}

.green {
	color: var(--color-green-500);
	background-color: var(--color-green-650);
	border: 1px solid var(--color-green-600);

	.title {
		color: var(--color-green-500);
	}
}

.grey {
	background-color: var(--color-gray-600);
	color: var(--color-grey-650);
}

.main {
	background-color: var(--color-pacific-500);

	.title {
		color: var(--color-base-white);
	}
}

.mainDarker {
	background-color: var(--color-pacific-650);
	color: var(--color-pacific-white);
}

.recommended {
	background-color: var(--color-pacific-700);
	color: var(--color-pacific-550);
}

.fastest {
	background-color: var(--color-red-700);
	color: var(--color-red-500);
}

.cheapest {
	background-color: rgb(from var(--color-pacific-700) r g b / 0.2);
	color: var(--color-pacific-600);
}

.transparent {
	background-color: none;
}

.secondary {
	background-color: var(--color-grey-650);
	border: 1px solid var(--color-gray-600);

	.title {
		color: var(--color-gray-500);
	}
}
