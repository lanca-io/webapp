.wrap {
	gap: var(--space-s);
}

.container {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	gap: var(--space-xxs);
	cursor: pointer;
}

.container > div:first-child > p:first-child {
	color: var(--color-gray-600);
	font-size: 1rem;
}

.priceFee {
	font-weight: 500;
	font-size: 1rem;
	color: var(--color-gray-700);
}

.iconWrap {
	justify-content: center;
	align-items: center;
	padding: var(--space-xs);
}
