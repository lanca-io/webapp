.summaryContainer {
	margin-top: 48px;
	display: flex;
	flex-direction: column;
	gap: var(--space-xs);

	h5 {
		color: var(--color-gray-600);
	}
}

.summaryContent {
	height: 100%;
	max-height: 308px;
	flex-direction: row;
	gap: var(--space-m);

	> div {
		width: 49%;
	}
}

.sectionTitle {
	color: var(--color-gray-600);
	font-weight: 500;
	font-size: 0.875rem;
}

@media (max-width: 1000px) {
	.summaryContent {
		flex-direction: column-reverse;
		max-height: 100%;

		> div {
			width: 100%;
		}
	}
}
