.widget_input_container {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	min-height: 56px;
	overflow: hidden;
}

.input {
	flex: 1;
	overflow: hidden;
	color: var(--color-gray-500);
	text-align: center;
	font-size: 48px;
	line-height: 56px;
	height: auto;
	font-style: normal;
	font-weight: 500;
	letter-spacing: -0.96px;
	border: none;
	outline: none;
	background: transparent;
	transition: color 0.2s ease;
}

.has_value {
	color: var(--color-gray-700) !important;
}

.input::placeholder {
	color: var(--color-gray-500);
}

.input:not([disabled]):hover {
	color: var(--color-gray-600);
}

.input:not([disabled]):hover::placeholder {
	color: var(--color-gray-600);
}
