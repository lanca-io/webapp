.source_card_wrapper {
	position: relative;
	width: 100%;
	border-radius: var(--space-l);
	box-shadow: 0px 20px 150px 0px var(--color-accent-100);
}

.severity_impact_danger {
	box-shadow: 0px 20px 150px 0px var(--color-danger-100);
}

.severity_impact_positive {
	box-shadow: 0px 20px 150px 0px var(--color-success-100);
}

.severity_impact_warning {
	box-shadow: 0px 20px 150px 0px var(--color-warning-100);
}

.source_card {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: var(--space-m) var(--space-m) var(--space-xxl) var(--space-m);
	gap: var(--space-s);
	align-self: stretch;
	border-radius: var(--space-l);
	background-color: var(--color-gray-25);
	border-bottom: 1px solid var(--color-gray-100);
	z-index: 1;
	position: relative;
}
