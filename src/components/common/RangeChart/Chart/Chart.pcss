.range_chart_visual {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-xs);
	flex: 1 0 0;
	width: 100%;

	& .range_chart_loader {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 0 0;
		width: 100%;
	}

	& .range_chart_container {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-xs);
		flex: 1 0 0;
		width: 100%;
		padding: 0 var(--space-s) var(--space-m) var(--space-s);

		& .range_chart_progress_bar {
			position: relative;
			flex: 1 0 36px;
			width: 100%;
			border-radius: 16px;
			background-color: var(--color-gray-50);

			&::before {
				content: '';
				position: absolute;
				inset: 0;
				width: var(--fill-width, 0%);
				background: var(--color-accent-100);
				border-radius: 16px;
				transition: width 0.4s ease-out;
			}
		}

		& .range_chart_labels {
			display: flex;
			justify-content: space-between;
			width: 100%;

			& .range_chart_label {
				font-size: 0.75rem;
				line-height: 1rem;
				font-weight: 400;
				color: var(--color-gray-500);
			}
		}
	}
}

@media (min-width: 1025px) and (max-width: 1919px) {
	.range_chart_visual {
		height: 144px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.range_chart_visual {
		height: 102px;
	}
}

@media (max-width: 640px) {
	.range_chart_visual {
		height: 78px;
	}
}
