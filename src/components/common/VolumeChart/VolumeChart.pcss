.volume_chart {
	display: flex;
	flex-direction: column;
	min-height: 396px;
	padding: var(--space-m);
	align-items: flex-start;
	gap: var(--space-m);
	width: 100%;
	border-radius: 24px;
	background-color: var(--color-gray-25);

	& .volume_chart_heading {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-xs);
		width: 100%;

		& .volume_chart_toolbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;

			& .volume_chart_description {
				display: flex;
				align-items: center;
				gap: var(--space-xs);

				& .volume_chart_label {
					font-size: 1.125rem;
					font-weight: 500;
					line-height: 1.375rem;
					color: var(--color-gray-700);
				}
			}
		}

		& .volume_chart_menu {
			display: flex;
			align-items: center;
			gap: var(--space-xxs);

			& .volume_chart_menu_option {
				width: 44px !important;
				height: 32px !important;
			}
		}

		& .volume_chart_total {
			display: flex;
			align-items: center;
			gap: var(--space-xs);

			& .volume_chart_total_symbol,
			& .volume_chart_total_value {
				font-size: 2rem;
				font-weight: 500;
				line-height: 2.25rem;
				color: var(--color-gray-700);
			}
		}
	}

	& .volume_chart_visual {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-xs);
		flex: 1 0 0;
		width: 100%;
	}
}
