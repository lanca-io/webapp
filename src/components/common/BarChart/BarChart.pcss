.bar_chart {
	display: flex;
	flex-direction: column;
	height: 396px;
	align-items: flex-start;
	gap: var(--space-m);
	width: 100%;
	border-radius: 24px;
	background-color: var(--color-gray-25);
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.bar_chart {
		height: 320px;
	}
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.bar_chart_compact {
		height: 258px;
	}
}

@media (min-width: 641px) and (max-width: 1024px) {
	.bar_chart_compact {
		height: 216px;
	}
}

@media (max-width: 640px) {
	.bar_chart_compact {
		height: 192px;
	}
}
