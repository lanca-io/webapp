.pool_action_card_pointer {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	pointer-events: none;
	background-color: var(--color-gray-25);
	z-index: 2;

	& .pool_action_card_pointer_icon {
		background-color: var(--color-gray-100);
		margin-left: var(--space-xs);
		margin-right: var(--space-xs);
		pointer-events: auto;
	}
}
