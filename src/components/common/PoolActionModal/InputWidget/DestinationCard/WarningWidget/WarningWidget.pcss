.pool_action_warning_widget {
	display: flex;
	padding: var(--space-xs);
	align-items: flex-start;
	gap: var(--space-s);
	width: 100%;
	border-radius: 16px;
	background-color: var(--color-warning-100);

	& .pool_action_warning_widget_icon {
		display: flex;
		align-items: center;
		padding: var(--space-s);
		justify-content: center;
		border-radius: 12px;
		background-color: var(--color-warning-25);
	}

	& .pool_action_warning_widget_info {
		display: flex;
		flex-direction: column;
		gap: var(--space-xxs);
		justify-content: center;
		align-items: flex-start;
		flex: 1 0 0;

		& .pool_action_warning_widget_title {
			font-size: 1.125rem;
			font-weight: 500;
			line-height: 1.375rem;
			color: var(--color-warning-700);
		}

		& .pool_action_warning_widget_subtitle {
			font-size: 1rem;
			font-weight: 500;
			line-height: 1.25rem;
			color: var(--color-warning-600);
		}
	}
}
