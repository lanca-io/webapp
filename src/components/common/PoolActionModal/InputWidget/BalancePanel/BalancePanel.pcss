.pool_action_balance_info_container {
	display: flex;
	flex-direction: row;
	height: 24px;
	gap: var(--space-xxs);
	align-items: center;
}

.pool_action_balance_info_title {
	font-size: 0.875rem;
	color: var(--color-gray-500);
	line-height: 18px;
	font-weight: 400;
}

.pool_action_balance_info_value,
.pool_action_balance_info_symbol {
	font-size: 0.875rem;
	color: var(--color-gray-600);
	font-weight: 500;
	line-height: 18px;
}

.pool_action_max_button {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 var(--space-xxs);
	margin: 0;
	background-color: transparent;
	color: var(--color-accent-600);
	font-size: 0.875rem;
	cursor: pointer;
}
