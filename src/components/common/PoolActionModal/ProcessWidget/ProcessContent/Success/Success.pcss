.pool_action_success {
	display: flex;
	flex-direction: column;
	height: 160px;
	justify-content: center;
	align-items: center;
	gap: var(--space-m);
}

.pool_action_success_image {
	max-width: 100%;
	height: auto;
}

.pool_action_success_info {
	display: flex;
	flex-direction: column;
	margin-top: var(--space-m);
	justify-content: center;
	align-items: center;
	gap: var(--space-s);
	width: 100%;
}

.pool_action_success_info_heading {
	display: flex;
	justify-content: center;
	align-items: center;
}

.pool_action_success_info_text {
	font-size: 1rem;
	font-weight: 500;
	line-height: 20px;
	color: var(--color-gray-700);
}

.pool_action_success_info_stats {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.pool_action_success_info_details {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: var(--space-xs);
	width: 100%;
}

.pool_action_success_info_pointer {
	font-size: 0.875rem;
	font-weight: 400;
	line-height: 18px;
}

.pool_action_success_info_token,
.pool_action_success_info_chain {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: var(--space-xxs);
}

.pool_action_success_info_name {
	font-size: 1rem;
	font-weight: 500;
	line-height: 18px;
	color: var(--color-gray-700);
}

.pool_action_success_info_number {
	font-size: 3rem;
	font-style: normal;
	line-height: 56px;
	letter-spacing: -0.96px;
	font-weight: 500;
	color: var(--color-gray-700);
}
