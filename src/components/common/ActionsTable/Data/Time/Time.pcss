.actions_table_time {
	display: flex;
	align-items: center;
	gap: var(--space-xxs);

	& .actions_table_fees_eta {
		font-size: 0.875rem;
		line-height: 1.125rem;
		font-weight: 500;
		color: var(--color-gray-500);
	}

	& .actions_table_fees_time_value {
		font-size: 0.875rem;
		line-height: 1.125rem;
		font-weight: 500;
		color: var(--color-gray-700);
	}
}
