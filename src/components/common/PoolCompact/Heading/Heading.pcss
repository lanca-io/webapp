.pool_compact_heading {
	display: flex;
	position: relative;
	flex-direction: column;
	width: 100%;

	& .pool_compact_tags {
		position: absolute;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: var(--space-xxs);
		z-index: 10;
		flex-shrink: 0;
	}

	& .pool_compact_heading_content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
		width: 100%;

		& .pool_compact_heading_logos {
			display: flex;
			height: 48px;
			flex-shrink: 0;
			position: relative;

			& .pool_compact_heading_logo_chain {
				width: 48px;
				height: 48px;
				border-radius: 16px;
				transform: rotate(15deg);
				margin-left: -5px;
				z-index: 1;
			}

			& .pool_compact_heading_logo_token {
				width: 48px;
				height: 48px;
				transform: rotate(-15deg);
				z-index: 2;
			}
		}

		& .pool_compact_heading_description {
			display: flex;
			align-items: center;
			gap: var(--space-xs);

			& .pool_compact_title_token {
				font-size: 1.5rem;
				font-weight: 500;
				color: var(--color-gray-700);
				line-height: 1.75rem;
			}

			& .pool_compact_title_chain {
				font-size: 1.5rem;
				font-weight: 500;
				color: var(--color-gray-500);
				line-height: 1.75rem;
			}
		}
	}
}
