.pool_card {
	display: flex;
	justify-content: space-between;
	width: 100%;
	padding: var(--space-m);
	align-items: center;
	gap: var(--space-m);
	border-radius: 24px;
	background-color: var(--color-gray-25);

	& .pool_card_actions {
		display: flex;
		align-items: center;
		gap: var(--space-xxs);
	}
}
