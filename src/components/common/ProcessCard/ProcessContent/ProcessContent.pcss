.process_content {
	width: 100%;
}

.approval_content,
.failure_content,
.success_content {
	display: flex;
	height: 160px;
	justify-content: center;
	align-items: center;
	gap: var(--space-m);
}

.success_data {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-s);
}
