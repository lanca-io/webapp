.pools_dashboard {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	max-width: 1388px;
	width: 100%;
	margin: 0 auto;
	padding: var(--space-xl) 0 0 0;
	gap: var(--space-xl);

	& .pools_analytics {
		display: flex;
		min-height: 396px;
		align-items: flex-start;
		width: 100%;
		gap: var(--space-m);
	}
}
