.container {
	display: flex;
	max-width: 452px;
	margin: 0 auto;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: var(--space-l);
}

.icon {
	display: flex;
	width: 48px;
	height: 48px;
	padding: var(--space-s);
	justify-content: center;
	align-items: center;
	border-radius: 12px;
	background: var(--color-accent-25);
	box-shadow: 0 0 8px 0 var(--color-accent-200);
}

.content {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-s);
	width: 100%;
}

.description {
	display: flex;
	text-align: center;
	align-items: center;
	gap: var(--space-xxs);
	width: 100%;
}

.title {
	font-size: 1.125rem;
	line-height: 1.375rem;
	font-weight: 500;
	color: var(--color-grey-700);
}

.subtitle {
	font-size: 1rem;
	line-height: 1.25rem;
	color: var(--color-gray-600);
}

.action {
	display: flex;
	flex-direction: row;
	gap: var(--space-xxs);
}

@media (min-width: 1025px) and (max-width: 1920px) {
	.container {
		max-width: 394px;
	}
}
@media (min-width: 641px) and (max-width: 1024px) {
	.container {
		max-width: 332px;
	}
}

@media (max-width: 640px) {
	.container {
		max-width: 100%;
	}
}
