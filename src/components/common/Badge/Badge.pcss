.badge {
	display: flex;
	align-items: center;
	height: fit-content;
	width: fit-content;
	position: relative;
}

.badge_img {
	border-radius: var(--space-xs);
	width: 24px;
	height: 24px;
}

.badge_xs {
	width: var(--space-s);
	height: var(--space-s);
}

.badge_s {
	width: var(--space-m);
	height: var(--space-m);
}

.badge_m {
	width: var(--space-l);
	height: var(--space-l);
}

.badge_l {
	width: var(--space-xxl);
	height: var(--space-xxl);
}

.badge_xl {
	width: var(--space-xxxl);
	height: var(--space-xxxl);
}

.badge_secondary_img {
	background-color: var(--color-gray-25);
	border-radius: var(--space-xxs);
	box-shadow:
		0 0 6px 0 rgba(52, 64, 84, 0.3),
		0 2px 3px 0 rgba(52, 64, 84, 0.15);
	position: absolute;
	bottom: 0;
	right: 0;
}
