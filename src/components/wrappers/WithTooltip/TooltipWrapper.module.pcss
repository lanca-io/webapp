.tooltip {
	z-index: 1;
	border-radius: 12px !important;
	background-color: var(--color-gray-900) !important;
	color: var(--color-gray-300) !important;
	padding: 12px !important;
	opacity: 1 !important;
	overflow: visible !important;

	h6 {
		color: var(--color-gray-100) !important;
		font-weight: 500;
		font-size: 14px;
	}
	p {
		color: var(--color-gray-300) !important;
		font-weight: 400;
		font-size: 14px;
	}
}
